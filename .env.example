OPENAI_API_KEY=
# Matches the default credentials in docker-compose.yml - works as-is for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optional: LLM observability (tracing). Leave blank to disable -
# the app runs fine without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com (must match your project region)
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: max articles scraped per ingestion run (default 30).
SCRAPE_LIMIT=30
